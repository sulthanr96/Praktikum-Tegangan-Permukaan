# MONGODB_URI: alamat database MongoDB (mis. MongoDB Atlas).
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER/kimia"

# ADMIN_PASSWORD: password login aslab (username "admin"). WAJIB diisi;
# tanpa ini login aslab dinonaktifkan.
ADMIN_PASSWORD="ganti-dengan-password-aslab"

# AUTH_SECRET: kunci acak panjang untuk menandatangani token login.
# Mengganti nilai ini membuat semua praktikan harus login ulang.
AUTH_SECRET="ganti-dengan-teks-acak-panjang"

# PORT: port server lokal (opsional, default 3001).
PORT=3001
